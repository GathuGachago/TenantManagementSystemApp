<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/dashboardTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tenantCountTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tenants\n0"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="#E8EEF7"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/dashboardTitleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/totalRentTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total rent\nKSh 0"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="#E8EEF7"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tenantCountTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>